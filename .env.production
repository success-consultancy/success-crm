# Build-time config for the success-crm static export (S3 + CloudFront).
#
# NEXT_PUBLIC_* values are INLINED into the JS bundle at build time -- there is
# no server to read them at runtime, so this file must be present when building,
# not when deploying. It is committed deliberately (see .gitignore): every value
# here is already readable in the shipped bundle, so none of it is secret.
#
# Build via `bun run build-success-crm`, which sets NODE_ENV=production so this file
# takes precedence over `.env` (bun preloads `.env` into process.env, which
# otherwise outranks it and silently bakes in localhost).

NEXT_PUBLIC_BACKEND_URL=https://api.successedu.com.au/success-crm

NEXT_PUBLIC_SMS_EMAIL=https://rgquxql3qqkd2rgkrkadx2xawi0jpvek.lambda-url.us-east-1.on.aws/canberra-email-sms
NEXT_PUBLIC_FILE_UPLOAD_URL=https://3lbqul2ps1.execute-api.us-east-1.amazonaws.com/Prod/fileUpload
NEXT_PUBLIC_TINY_EDITOR_KEY=42nxxqrkpjpteivziub4j6bewh1g35vispphcadf4llspme9
